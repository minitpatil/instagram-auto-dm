// Prisma schema for Instagram Automation Platform

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  TESTER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum InstagramAccountStatus {
  ACTIVE
  DISCONNECTED
  SUSPENDED
}

enum AutomationStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum TargetType {
  POST
  REEL
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  instagramAccounts InstagramAccount[]
  files             File[]
  automations       Automation[]
  auditLogs         AuditLog[]
}

model InstagramAccount {
  id                   String                  @id @default(uuid())
  userId               String
  instagramUserId      String                  @unique
  username             String
  name                 String?
  accessTokenEncrypted String
  status               InstagramAccountStatus @default(ACTIVE)

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations          Automation[]

  @@index([userId])
}

model Automation {
  id                  String            @id @default(uuid())
  userId              String
  instagramAccountId  String

  targetUrl           String
  mediaId             String?
  targetType          TargetType?

  publicReply         String?
  dmMessage           String?

  fileId              String?
  status              AutomationStatus @default(ACTIVE)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccount    InstagramAccount  @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  file                File?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  logs                AutomationLog[]

  @@index([userId])
  @@index([instagramAccountId])
  @@index([mediaId])
}

model File {
  id          String       @id @default(uuid())
  userId      String
  name        String
  content     String
  mimeType    String       @default("text/plain")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations Automation[]

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?

  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model AutomationLog {
  id                 String     @id @default(uuid())
  automationId       String
  eventType          String
  commenterUsername  String?
  commentId          String?
  success             Boolean    @default(false)
  errorMessage       String?

  createdAt           DateTime   @default(now())

  automation          Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([commentId])
  @@index([createdAt])
}